<Project Sdk="Microsoft.NET.Sdk">
  <!--
    THE INFRASTRUCTURE LAYER: the adapters. Implements the Application's ports with real technology:
    EF Core + SQL Server for the write model, SQL projections and MongoDB for read models.
    Depends on Application (to see the ports) and Domain (to map aggregates).
    Nothing depends on Infrastructure except the composition root (Api).
  -->
  <PropertyGroup>
    <RootNamespace>CarRental.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- IConfiguration, hosting and logging abstractions come from the shared ASP.NET Core framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CarRental.Application\CarRental.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CarRental.IntegrationTests" />
  </ItemGroup>
</Project>
