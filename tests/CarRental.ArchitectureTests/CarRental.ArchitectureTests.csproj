<Project Sdk="Microsoft.NET.Sdk">
  <!-- Guards the Dependency Rule automatically, so the architecture cannot erode silently in a PR. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\services\CarRental.Api\CarRental.Api.csproj" />
  </ItemGroup>
</Project>
